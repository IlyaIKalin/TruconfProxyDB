# Copy this file to .env and replace every change-me value.
# Do not commit .env.

POSTGRES_DB=truconf_proxydb
POSTGRES_USER=truconf_proxydb
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432

SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=

SPRING_FLYWAY_ENABLED=true
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=110MB

TRUCONF_BOT_HTTP_BASE_URL=https://s13.trueconf.rt.ru
TRUCONF_BOT_WS_URL=wss://s13.trueconf.rt.ru/websocket/chat_bot/
TRUCONF_BOT_CLIENT_ID=change-me
TRUCONF_BOT_USERNAME=bot-user
TRUCONF_BOT_PASSWORD=change-me
TRUCONF_PROXY_API_KEY=change-me
TRUCONF_FILE_STORAGE_DIR=/var/lib/truconf-proxydb/files
TRUCONF_TLS_INSECURE_SKIP_VERIFY=false

TRUCONF_DISPATCHER_ENABLED=true
TRUCONF_DISPATCHER_BATCH_SIZE=50
TRUCONF_DISPATCHER_POLL_INTERVAL=5s
TRUCONF_DISPATCHER_LOCK_TIMEOUT=2m
TRUCONF_DISPATCHER_WORKER_THREADS=4

TRUCONF_RETRY_MAX_ATTEMPTS=10
TRUCONF_RETRY_INITIAL_DELAY=5s
TRUCONF_RETRY_MAX_DELAY=5m
TRUCONF_RETRY_MULTIPLIER=2.0

TRUCONF_RATE_LIMIT_COMMANDS_PER_SECOND=10

TRUCONF_WEBSOCKET_REQUEST_TIMEOUT=30s
TRUCONF_WEBSOCKET_CONNECT_TIMEOUT=10s
TRUCONF_WEBSOCKET_RECONNECT_DELAY=5s

TRUCONF_SERVER_API_BASE_URL=https://s13.trueconf.rt.ru
TRUCONF_SERVER_API_CLIENT_ID=change-me
TRUCONF_SERVER_API_CLIENT_SECRET=change-me
TRUCONF_SERVER_API_GRANT_TYPE=client_credentials
TRUCONF_SERVER_API_USERNAME=
TRUCONF_SERVER_API_PASSWORD=
TRUCONF_SERVER_API_PAGE_SIZE=100
TRUCONF_SERVER_API_MAX_SCAN_PAGES=20
